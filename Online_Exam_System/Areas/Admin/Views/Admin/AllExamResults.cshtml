@{
    ViewData["Title"] = "All Exam Results";
    Layout = "_Layout";
}

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>All Exam Results</h2>
        <div class="search-container">
            <div class="input-group">
                <input type="text" id="searchInput" class="form-control" placeholder="Search by username or email...">
                <button class="btn btn-outline-secondary" type="button" id="searchButton">
                    <i class="fas fa-search"></i>
                </button>
            </div>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>User</th>
                    <th>Email</th>
                    <th>Exam</th>
                    <th>Score</th>
                    <th>Result</th>
                    <th>Date Taken</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody id="resultsTableBody">
                @foreach (var result in Model)
                {
                    <tr class="result-row" 
                        data-username="@result.UserName" 
                        data-email="@result.UserEmail">
                        <td>@result.UserName</td>
                        <td>@result.UserEmail</td>
                        <td>@result.ExamTitle</td>
                        <td>
                            <span class="badge @(result.UserExam.Passed ? "bg-success" : "bg-danger")">
                                @result.UserExam.Score.ToString("0.00")%
                            </span>
                        </td>
                        <td>
                            @if (result.UserExam.Passed)
                            {
                                <span class="text-success">Passed</span>
                            }
                            else
                            {
                                <span class="text-danger">Failed</span>
                            }
                        </td>
                        <td>@result.UserExam.TakenAt.ToString("f")</td>
                        <td>
                            <a href="@Url.Action("UserExamDetails", new { userExamId = result.UserExam.Id })" 
                               class="btn btn-sm btn-info">
                                <i class="fas fa-eye"></i> Details
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="d-flex justify-content-center mt-4">
        <nav aria-label="Page navigation">
            <ul class="pagination" id="pagination">
                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                {
                    <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                        <a class="page-link" href="@Url.Action("AllExamResults", new { pageNumber = i })">@i</a>
                    </li>
                }
            </ul>
        </nav>
    </div>
</div>

@section Styles {
    <style>
        .table th {
            background-color: #f8f9fa;
        }
        .badge {
            font-size: 0.9em;
            padding: 0.35em 0.65em;
        }
        .search-container {
            width: 300px;
        }
        .result-row {
            display: table-row;
        }
        .result-row.hidden {
            display: none;
        }
    </style>
}

@section Scripts {
    <script>
        $(document).ready(function() {
            const searchInput = $('#searchInput');
            const searchButton = $('#searchButton');
            const resultRows = $('.result-row');

            function performSearch() {
                const searchTerm = searchInput.val().toLowerCase();
                
                resultRows.each(function() {
                    const username = $(this).data('username').toLowerCase();
                    const email = $(this).data('email').toLowerCase();
                    
                    if (username.includes(searchTerm) || email.includes(searchTerm)) {
                        $(this).removeClass('hidden');
                    } else {
                        $(this).addClass('hidden');
                    }
                });
            }

            // Search on button click
            searchButton.on('click', performSearch);

            // Search on Enter key press
            searchInput.on('keypress', function(e) {
                if (e.which === 13) {
                    performSearch();
                }
            });

            // Search as you type (with debounce)
            let searchTimeout;
            searchInput.on('input', function() {
                clearTimeout(searchTimeout);
                searchTimeout = setTimeout(performSearch, 300);
            });
        });
    </script>
} 