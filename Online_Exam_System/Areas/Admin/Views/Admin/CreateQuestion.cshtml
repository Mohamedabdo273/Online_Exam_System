@model Models.Models.Question
@{
    ViewData["Title"] = "Create Question";
    Layout = "_Layout";
}

<h2>Create Question</h2>

<form asp-action="CreateQuestion" method="post" id="createQuestionForm">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="ExamId" />

    <div class="form-group mb-3">
        <label asp-for="Title" class="form-label">Title</label>
        @Html.EditorFor(model => model.Title, new { htmlAttributes = new { @class = "form-control" } })
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>

    <h6>Choices (Mark one as correct)</h6>
    <div class="choices-container">
        @for (int i = 0; i < 4; i++)
        {
            <div class="choice-item mb-3">
                <div class="input-group">
                    <input type="text" class="form-control"
                           name="Choices[@i].Text"
                           placeholder="Choice text"
                           required />
                    <div class="input-group-text">
                        <input type="radio" name="correctChoiceIndex" value="@i" required />
                        <label class="ms-1">Correct</label>
                    </div>
                </div>
            </div>
        }
    </div>

    <button type="submit" class="btn btn-primary">Save Question</button>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
