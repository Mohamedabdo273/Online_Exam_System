@model Models.Models.Choice
@{
    ViewData["Title"] = "Edit Choice";
}

<div class="container mt-4">
    <h2>Edit Choice</h2>

    <form asp-action="EditChoice" method="post" id="editChoiceForm">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="QuestionId" />

        <div class="mb-3">
            <label asp-for="Text" class="form-label"></label>
            <input asp-for="Text" class="form-control" required />
            <div class="invalid-feedback">Please provide choice text.</div>
        </div>

        <div class="form-check mb-3">
            <input asp-for="IsCorrect" class="form-check-input" />
            <label asp-for="IsCorrect" class="form-check-label"></label>
        </div>

        <div class="d-flex justify-content-between">
            <a href="@Url.Action("GetChoices", new { questionId = Model.QuestionId })" class="btn btn-secondary">Back to Choices</a>
            <button type="submit" class="btn btn-primary">Save Changes</button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Form validation
            $('#editChoiceForm').submit(function(e) {
                const form = this;
                if (!form.checkValidity()) {
                    e.preventDefault();
                    e.stopPropagation();
                }
                $(form).addClass('was-validated');
            });
        });
    </script>
}