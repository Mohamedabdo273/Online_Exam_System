@using Models.Models
@model Question
@{
    ViewData["Title"] = "Edit Question";
    Layout = "_Layout";
}
<style>
    /* Main Container Styles */
    .container.mt-4 {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 15px;
    }

    /* Header Section */
    .d-flex.justify-content-between.align-items-center.mb-4 {
        padding-bottom: 15px;
        border-bottom: 1px solid #dee2e6;
    }

    /* Button Styles */
    .btn-outline-secondary {
        border-color: #6c757d;
        color: #6c757d;
    }

        .btn-outline-secondary:hover {
            background-color: #6c757d;
            color: white;
        }

    .btn-primary {
        background-color: #0d6efd;
        border-color: #0d6efd;
    }

        .btn-primary:hover {
            background-color: #0b5ed7;
            border-color: #0a58ca;
        }

    /* Question List Styles */
    .list-group {
        border-radius: 0.25rem;
        box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
    }

    .list-group-item {
        padding: 1.25rem;
        border-left: 0;
        border-right: 0;
    }

        .list-group-item:first-child {
            border-top: 0;
        }

    .list-group-item-action:hover {
        background-color: #f8f9fa;
    }

    /* Question Title */
    .list-group-item h5 {
        margin-bottom: 0.5rem;
        font-weight: 500;
    }

    /* Choice Badges */
    .choices-container {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .badge {
        padding: 0.5em 0.75em;
        font-weight: 500;
        font-size: 0.85rem;
    }

    .bg-success {
        background-color: #198754 !important;
    }

    .bg-secondary {
        background-color: #6c757d !important;
    }

    /* Action Buttons */
    .list-group-item .btn {
        margin-left: 0.5rem;
        font-size: 0.875rem;
    }

    .btn-sm {
        padding: 0.25rem 0.5rem;
    }

    .btn-warning {
        background-color: #ffc107;
        border-color: #ffc107;
    }

    .btn-danger {
        background-color: #dc3545;
        border-color: #dc3545;
    }

    .btn-info {
        background-color: #0dcaf0;
        border-color: #0dcaf0;
    }

    /* Alert Styles */
    .alert {
        padding: 1rem;
        border-radius: 0.25rem;
        margin-bottom: 1rem;
    }

    .alert-danger {
        background-color: #f8d7da;
        border-color: #f5c2c7;
        color: #842029;
    }

    .alert-info {
        background-color: #cfe2ff;
        border-color: #b6d4fe;
        color: #084298;
    }

    /* Modal Styles */
    .modal-content {
        border: none;
        border-radius: 0.5rem;
    }

    .modal-header {
        border-bottom: 1px solid #dee2e6;
        padding: 1rem 1.5rem;
    }

    .modal-body {
        padding: 1.5rem;
    }

    .modal-footer {
        border-top: 1px solid #dee2e6;
        padding: 1rem 1.5rem;
    }

    /* Form Styles */
    .form-control {
        padding: 0.375rem 0.75rem;
        border-radius: 0.25rem;
        border: 1px solid #ced4da;
    }

        .form-control:focus {
            border-color: #86b7fe;
            box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25);
        }

    .invalid-feedback {
        color: #dc3545;
        font-size: 0.875rem;
    }



    {
        flex-direction: column;
        align-items: flex-start;
        gap: 1rem;
    }

    .list-group-item {
        flex-direction: column;
        gap: 1rem;
    }

        .list-group-item > div:last-child {
            align-self: flex-end;
        }

    .choices-container {
        margin-bottom: 1rem;
    }

    .list-group-item .btn {
        margin: 0.25rem;
    }

    }


    .modal-content {
        border-radius: 0;
    }

    .list-group-item .btn {
        font-size: 0.75rem;
        padding: 0.2rem 0.4rem;
    }

    }

    /* Loading Spinner (for AJAX operations) */
    .loading-spinner {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.5);
        z-index: 9999;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .spinner-border {
        width: 3rem;
        height: 3rem;
        color: white;
    }
</style>
<div class="container mt-4">
    <h2>Edit Question</h2>

    @if (ViewData.ModelState.ErrorCount > 0)
    {
        <div class="alert alert-danger">
            <h4>Validation Errors:</h4>
            <ul>
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@error.ErrorMessage</li>
                }
            </ul>
        </div>
    }

    <form asp-action="EditQuestion" method="post" id="editQuestionForm">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="ExamId" />

        <div class="form-group mb-3">
            <label asp-for="Title" class="form-label">Title</label>
            @Html.EditorFor(model => model.Title, new { htmlAttributes = new { @class = "form-control" } })
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>

        <h6>Choices (Mark one as correct)</h6>
        <div class="choices-container">
            @{
                var choices = Model.Choices?.ToList() ?? new List<Choice>();
                for (int i = choices.Count; i < 4; i++)
                {
                    choices.Add(new Choice { Text = "" });
                }
                var correctIndex = choices.FindIndex(c => c.IsCorrect);
            }

            <div class="choices-container">
                @for (int i = 0; i < 4; i++)
                {
                    <div class="choice-item mb-3">
                        <div class="input-group">
                            <input type="text" class="form-control"
                                   name="Choices[@i].Text"
                                   placeholder="Choice text"
                                   required />
                            <div class="input-group-text">
                                <input type="radio" name="correctChoiceIndex" value="@i" required />
                                <label class="ms-1">Correct</label>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="form-group mt-3">
            <button type="submit" class="btn btn-primary">Save Changes</button>
            <a asp-action="GetQuestions" asp-route-examId="@Model.ExamId"
               class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $(document).ready(function() {
            $('#editQuestionForm').submit(function(e) {
                const form = this;
                if (!form.checkValidity()) {
                    e.preventDefault();
                    e.stopPropagation();
                }
                $(form).addClass('was-validated');
            });
        });
    </script>
}