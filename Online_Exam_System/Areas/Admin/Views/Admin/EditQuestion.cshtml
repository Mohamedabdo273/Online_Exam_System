@model Models.Models.Question
@{
    ViewData["Title"] = "Edit Question";
}

<div class="container mt-4">
    <h2>Edit Question</h2>

    <form asp-action="EditQuestion" method="post" id="editQuestionForm">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="ExamId" />

        <div class="mb-3">
            <label asp-for="Title" class="form-label"></label>
            <input asp-for="Title" class="form-control" required />
            <div class="invalid-feedback">Please provide question text.</div>
        </div>

        <div class="d-flex justify-content-between">
            <a href="@Url.Action("GetQuestions", new { examId = Model.ExamId })" class="btn btn-secondary">Back to Questions</a>
            <button type="submit" class="btn btn-primary">Save Changes</button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Form validation
            $('#editQuestionForm').submit(function(e) {
                const form = this;
                if (!form.checkValidity()) {
                    e.preventDefault();
                    e.stopPropagation();
                }
                $(form).addClass('was-validated');
            });
        });
    </script>
}