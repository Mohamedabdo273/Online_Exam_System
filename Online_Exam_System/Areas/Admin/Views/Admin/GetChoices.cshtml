
@using Models.Models
@model IEnumerable<Choice>
@{
    ViewData["Title"] = "Question Choices";
    var questionId = ViewBag.QuestionId;
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Manage Choices</h2>
        <div>
            <a href="@Url.Action("GetQuestions", new { examId = Model.FirstOrDefault()?.Question?.ExamId })"
               class="btn btn-outline-secondary me-2">
                <i class="fas fa-arrow-left"></i> Back to Questions
            </a>
            <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createChoiceModal">
                <i class="fas fa-plus"></i> Add Choice
            </button>
        </div>
    </div>

    <div class="list-group" id="choicesList">
        @foreach (var choice in Model)
        {
            <div class="list-group-item list-group-item-action">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="@(choice.IsCorrect ? "text-success fw-bold" : "")">
                            @choice.Text
                            @if (choice.IsCorrect)
                            {
                                <span class="badge bg-success ms-2">Correct</span>
                            }
                        </span>
                    </div>
                    <div>
                        <a href="@Url.Action("EditChoice", new { id = choice.Id })" class="btn btn-sm btn-warning me-1">
                            <i class="fas fa-edit"></i> Edit
                        </a>
                        <button class="btn btn-sm btn-danger delete-choice" data-choice-id="@choice.Id">
                            <i class="fas fa-trash"></i> Delete
                        </button>
                        @if (!choice.IsCorrect)
                        {
                            <button class="btn btn-sm btn-success set-correct-choice" data-choice-id="@choice.Id">
                                <i class="fas fa-check"></i> Mark as Correct
                            </button>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info mt-3">No choices added yet.</div>
    }
</div>

<!-- Create Choice Modal -->
<div class="modal fade" id="createChoiceModal" tabindex="-1" aria-labelledby="createChoiceModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="createChoiceModalLabel">Add New Choice</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="createChoiceForm" asp-action="CreateChoice">
                <input type="hidden" name="QuestionId" value="@questionId" />
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="Text" class="form-label">Choice Text</label>
                        <input type="text" class="form-control" id="Text" name="Text" required>
                        <div class="invalid-feedback">Please provide choice text.</div>
                    </div>
                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" id="IsCorrect" name="IsCorrect">
                        <label class="form-check-label" for="IsCorrect">
                            Mark as correct answer
                        </label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-primary">Add Choice</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteChoiceModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirm Delete</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete this choice?</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="confirmDeleteChoice">Delete</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Delete choice confirmation
            let choiceIdToDelete = null;

            $('.delete-choice').click(function() {
                choiceIdToDelete = $(this).data('choice-id');
                $('#deleteChoiceModal').modal('show');
            });

            $('#confirmDeleteChoice').click(function() {
                if (choiceIdToDelete) {
                    $.ajax({
                        url: '@Url.Action("DeleteChoice")',
                        type: 'POST',
                        data: { id: choiceIdToDelete },
                        headers: {
                            'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                        },
                        success: function() {
                            location.reload();
                        },
                        error: function(xhr) {
                            alert('Error deleting choice: ' + xhr.responseText);
                        }
                    });
                }
                $('#deleteChoiceModal').modal('hide');
            });

            // Set correct choice
            $('.set-correct-choice').click(function() {
                const choiceId = $(this).data('choice-id');

                $.ajax({
                    url: '@Url.Action("SetCorrectChoice", "Admin")',
                    type: 'POST',
                    data: { choiceId: choiceId },
                    headers: {
                        'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function() {
                        location.reload();
                    },
                    error: function(xhr) {
                        alert('Error setting correct choice: ' + xhr.responseText);
                    }
                });
            });

            // Form validation for create choice
            $('#createChoiceForm').submit(function(e) {
                const form = this;
                if (!form.checkValidity()) {
                    e.preventDefault();
                    e.stopPropagation();
                }
                $(form).addClass('was-validated');
            });
        });
    </script>
}