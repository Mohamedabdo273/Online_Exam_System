@using Models.Models
@model IEnumerable<Question>
@{
    ViewData["Title"] = "Exam Questions";
    var examId = ViewBag.ExamId;
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Manage Questions</h2>
        <div>
            <a href="@Url.Action("ExamDetails", new { id = examId })" class="btn btn-outline-secondary me-2">
                <i class="fas fa-arrow-left"></i> Back to Exam
            </a>
            <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createQuestionModal">
                <i class="fas fa-plus"></i> Add Question
            </button>
        </div>
    </div>

    <div class="list-group" id="questionsList">
        @foreach (var question in Model)
        {
            <div class="list-group-item list-group-item-action">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h5>@question.Title</h5>
                        <div class="choices-container mt-2">
                            @foreach (var choice in question.Choices)
                            {
                                <span class="badge @(choice.IsCorrect ? "bg-success" : "bg-secondary") me-1">
                                    @choice.Text
                                </span>
                            }
                        </div>
                    </div>
                    <div>
                        <a href="@Url.Action("EditQuestion", new { id = question.Id })" class="btn btn-sm btn-warning me-1">
                            <i class="fas fa-edit"></i> Edit
                        </a>
                        <button class="btn btn-sm btn-danger delete-question" data-question-id="@question.Id">
                            <i class="fas fa-trash"></i> Delete
                        </button>
                        <a href="@Url.Action("GetChoices", new { questionId = question.Id })" class="btn btn-sm btn-info">
                            <i class="fas fa-cog"></i> Manage Choices
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info mt-3">No questions added yet.</div>
    }
</div>

<!-- Create Question Modal -->
<div class="modal fade" id="createQuestionModal" tabindex="-1" aria-labelledby="createQuestionModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="createQuestionModalLabel">Add New Question</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="createQuestionForm" asp-action="CreateQuestion">
                <input type="hidden" name="ExamId" value="@examId" />
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="Title" class="form-label">Question Text</label>
                        <input type="text" class="form-control" id="Title" name="Title" required>
                        <div class="invalid-feedback">Please provide question text.</div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-primary">Add Question</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteQuestionModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirm Delete</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete this question? All related choices will also be deleted.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="confirmDeleteQuestion">Delete</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Delete question confirmation
            let questionIdToDelete = null;

            $('.delete-question').click(function() {
                questionIdToDelete = $(this).data('question-id');
                $('#deleteQuestionModal').modal('show');
            });

            $('#confirmDeleteQuestion').click(function() {
                if (questionIdToDelete) {
                    $.ajax({
                        url: '@Url.Action("DeleteQuestion")',
                        type: 'POST',
                        data: { id: questionIdToDelete },
                        headers: {
                            'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                        },
                        success: function() {
                            location.reload();
                        },
                        error: function(xhr) {
                            alert('Error deleting question: ' + xhr.responseText);
                        }
                    });
                }
                $('#deleteQuestionModal').modal('hide');
            });

            // Form validation for create question
            $('#createQuestionForm').submit(function(e) {
                const form = this;
                if (!form.checkValidity()) {
                    e.preventDefault();
                    e.stopPropagation();
                }
                $(form).addClass('was-validated');
            });
        });
    </script>
}