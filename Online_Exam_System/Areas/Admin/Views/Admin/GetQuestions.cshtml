@using Models.Models
@model IEnumerable<Question>
@{
    ViewData["Title"] = "Exam Questions";
    var examId = ViewBag.ExamId;
    Layout = "_Layout";
}
<style>
    /* Main Container Styles */
    .container.mt-4 {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 15px;
    }

    /* Header Section */
    .d-flex.justify-content-between.align-items-center.mb-4 {
        padding-bottom: 15px;
        border-bottom: 1px solid #dee2e6;
    }

    /* Button Styles */
    .btn-outline-secondary {
        border-color: #6c757d;
        color: #6c757d;
    }

        .btn-outline-secondary:hover {
            background-color: #6c757d;
            color: white;
        }

    .btn-primary {
        background-color: #0d6efd;
        border-color: #0d6efd;
    }

        .btn-primary:hover {
            background-color: #0b5ed7;
            border-color: #0a58ca;
        }

    /* Question List Styles */
    .list-group {
        border-radius: 0.25rem;
        box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
    }

    .list-group-item {
        padding: 1.25rem;
        border-left: 0;
        border-right: 0;
    }

        .list-group-item:first-child {
            border-top: 0;
        }

    .list-group-item-action:hover {
        background-color: #f8f9fa;
    }

    /* Question Title */
    .list-group-item h5 {
        margin-bottom: 0.5rem;
        font-weight: 500;
    }

    /* Choice Badges */
    .choices-container {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .badge {
        padding: 0.5em 0.75em;
        font-weight: 500;
        font-size: 0.85rem;
    }

    .bg-success {
        background-color: #198754 !important;
    }

    .bg-secondary {
        background-color: #6c757d !important;
    }

    /* Action Buttons */
    .list-group-item .btn {
        margin-left: 0.5rem;
        font-size: 0.875rem;
    }

    .btn-sm {
        padding: 0.25rem 0.5rem;
    }

    .btn-warning {
        background-color: #ffc107;
        border-color: #ffc107;
    }

    .btn-danger {
        background-color: #dc3545;
        border-color: #dc3545;
    }

    .btn-info {
        background-color: #0dcaf0;
        border-color: #0dcaf0;
    }

    /* Alert Styles */
    .alert {
        padding: 1rem;
        border-radius: 0.25rem;
        margin-bottom: 1rem;
    }

    .alert-danger {
        background-color: #f8d7da;
        border-color: #f5c2c7;
        color: #842029;
    }

    .alert-info {
        background-color: #cfe2ff;
        border-color: #b6d4fe;
        color: #084298;
    }

    /* Modal Styles */
    .modal-content {
        border: none;
        border-radius: 0.5rem;
    }

    .modal-header {
        border-bottom: 1px solid #dee2e6;
        padding: 1rem 1.5rem;
    }

    .modal-body {
        padding: 1.5rem;
    }

    .modal-footer {
        border-top: 1px solid #dee2e6;
        padding: 1rem 1.5rem;
    }

    /* Form Styles */
    .form-control {
        padding: 0.375rem 0.75rem;
        border-radius: 0.25rem;
        border: 1px solid #ced4da;
    }

        .form-control:focus {
            border-color: #86b7fe;
            box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25);
        }

    .invalid-feedback {
        color: #dc3545;
        font-size: 0.875rem;
    }

   

    {
        flex-direction: column;
        align-items: flex-start;
        gap: 1rem;
    }

    .list-group-item {
        flex-direction: column;
        gap: 1rem;
    }

        .list-group-item > div:last-child {
            align-self: flex-end;
        }

    .choices-container {
        margin-bottom: 1rem;
    }

    .list-group-item .btn {
        margin: 0.25rem;
    }

    }

    
    .modal-content {
        border-radius: 0;
    }

    .list-group-item .btn {
        font-size: 0.75rem;
        padding: 0.2rem 0.4rem;
    }

    }

    /* Loading Spinner (for AJAX operations) */
    .loading-spinner {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.5);
        z-index: 9999;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .spinner-border {
        width: 3rem;
        height: 3rem;
        color: white;
    }
</style>
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Manage Questions</h2>
        <div>
            <a href="@Url.Action("ExamDetails", new { id = examId })" class="btn btn-outline-secondary me-2">
                <i class="fas fa-arrow-left"></i> Back to Exam
            </a>
            <a href="@Url.Action("CreateQuestion", "Admin", new { examId = examId })" class="btn btn-primary">
                <i class="fas fa-plus"></i> Add Question
            </a>
        </div>
    </div>

    @if (Model == null)
    {
        <div class="alert alert-danger">
            Failed to load questions. Please try again.
        </div>
    }
    else if (!Model.Any())
    {
        <div class="alert alert-info">No questions added yet.</div>
    }
    else
    {
        <div class="list-group" id="questionsList">
            @foreach (var question in Model)
            {
                <div class="list-group-item list-group-item-action">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5>@question.Title</h5>
                        <div>
                            <a href="@Url.Action("EditQuestion", new { id = question.Id, examId = examId })" class="btn btn-sm btn-warning">
                                <i class="fas fa-trash-alt"></i> Edit
                            </a>
                            <button class="btn btn-danger btn-sm delete-question" data-question-id="@question.Id">
                                <i class="fas fa-trash"></i> Delete
                            </button>
                        </div>
                    </div>

                    <div class="choices-container mt-2">
                        @foreach (var choice in question.Choices)
                        {
                            var badgeClass = choice.IsCorrect ? "bg-success" : "bg-secondary";
                            <span class="badge @badgeClass">@choice.Text</span>
                        }
                    </div>
                </div>
            }
        </div>
    }
    </div>
<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteQuestionModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirm Delete</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete this question? All related choices will also be deleted.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="confirmDeleteQuestion">Delete</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Delete question confirmation
            let questionIdToDelete = null;

            $('.delete-question').click(function() {
                questionIdToDelete = $(this).data('question-id');
                $('#deleteQuestionModal').modal('show');
            });

            $('#confirmDeleteQuestion').click(function() {
                if (questionIdToDelete) {
                    // Get the anti-forgery token
                    const token = $('input[name="__RequestVerificationToken"]').val();

                    $.ajax({
                        url: '@Url.Action("DeleteQuestion")',
                        type: 'POST',
                        data: {
                            id: questionIdToDelete,
                            __RequestVerificationToken: token
                        },
                        success: function() {
                            location.reload();
                        },
                        error: function(xhr) {
                            console.error('Error:', xhr.responseText);
                            alert('Error deleting question: ' + xhr.responseText);
                        }
                    });
                }
                $('#deleteQuestionModal').modal('hide');
            });
        });
    </script>
}