@model dynamic
@{
    ViewData["Title"] = "UserDetails";
}

@{
    Layout = "_Layout";
}
@section Styles {

  <style >
        /* Base Styles */
        .user-details-container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 2rem 1rem;
        }

        /* Card Styles */
        .user-card {
            border-radius: 0.5rem;
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.1);
            overflow: hidden;
            border: none;
        }

        .user-card-header {
            padding: 1.25rem 1.5rem;
            background: linear-gradient(135deg, #3a7bd5 0%, #00d2ff 100%);
        }

        .user-card-body {
            padding: 1.5rem;
        }

        /* Typography */
        .user-detail-title {
            font-size: 1.25rem;
            font-weight: 600;
            color: #2c3e50;
            border-bottom: 2px solid #f8f9fa;
            padding-bottom: 0.5rem;
            margin-bottom: 1rem;
        }

        .user-detail-label {
            font-weight: 500;
            color: #6c757d;
        }

        .user-detail-value {
            font-weight: 400;
            color: #495057;
        }

        /* Badges */
        .role-badge {
            font-size: 0.85rem;
            padding: 0.5em 0.75em;
            margin-right: 0.5rem;
            margin-bottom: 0.5rem;
            display: inline-block;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border-radius: 0.25rem;
        }

        /* Action Buttons */
        .action-btn {
            transition: all 0.3s ease;
            font-weight: 500;
            padding: 0.5rem 1rem;
            border-radius: 0.375rem;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            color: white;
            border: none;
            cursor: pointer;
        }

            .action-btn i {
                font-size: 0.9rem;
            }

        .btn-delete {
            background: linear-gradient(135deg, #ff);
            // Incomplete gradient
        }
  </style>
}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>User Details</h2>
        <a href="@Url.Action("GetAllUsers")" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left"></i> Back to Users
        </a>
    </div>

    <div class="card">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">@Model.Email</h4>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <h5>User Information</h5>
                    <dl class="row">
                        <dt class="col-sm-4">User ID:</dt>
                        <dd class="col-sm-8">@Model.Id</dd>

                        <dt class="col-sm-4">FullName:</dt>
                        <dd class="col-sm-8">@Model.FullName</dd>

                        <dt class="col-sm-4">Email:</dt>
                        <dd class="col-sm-8">@Model.Email</dd>
                    </dl>
                </div>
                <div class="col-md-6">
                    <h5>Roles</h5>
                    <div class="mb-3">
                        @foreach (var role in Model.Roles)
                        {
                            <span class="badge bg-primary me-1">@role</span>
                        }
                    </div>
                </div>
            </div>
        </div>
        <div class="card-footer">
            <button class="btn btn-danger delete-user" data-user-id="@Model.Id">
                <i class="fas fa-trash"></i> Delete User
            </button>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteUserModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirm Delete</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete this user? This action cannot be undone.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="confirmDeleteUser">Delete</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Delete user confirmation
            $('.delete-user').click(function() {
                const userId = $(this).data('user-id');
                $('#deleteUserModal').modal('show');

                $('#confirmDeleteUser').off('click').on('click', function() {
                    $.ajax({
                        url: '@Url.Action("DeleteUser")',
                        type: 'POST',
                        data: { id: userId },
                        headers: {
                            'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                        },
                        success: function(response) {
                            if (response.success) {
                                window.location.href = '@Url.Action("GetAllUsers")';
                            } else {
                                alert('Error: ' + response.message);
                            }
                        },
                        error: function(xhr) {
                            alert('Error deleting user: ' + xhr.responseText);
                        }
                    });
                    $('#deleteUserModal').modal('hide');
                });
            });
        });
    </script>
}