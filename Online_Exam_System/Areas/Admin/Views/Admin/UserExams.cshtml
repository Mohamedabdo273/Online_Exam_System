@{
    ViewData["Title"] = "User Exams";
    Layout = "_Layout";
}

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>@ViewBag.UserName's Exams</h2>
            <p class="text-muted">@ViewBag.UserEmail</p>
        </div>
        <a href="@Url.Action("GetAllUsers")" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left"></i> Back to Users
        </a>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Exam</th>
                    <th>Score</th>
                    <th>Result</th>
                    <th>Date Taken</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var result in Model)
                {
                    <tr>
                        <td>@result.ExamTitle</td>
                        <td>
                            <span class="badge @(result.Passed ? "bg-success" : "bg-danger")">
                                @result.Score.ToString("0.00")%
                            </span>
                        </td>
                        <td>
                            @if (result.Passed)
                            {
                                <span class="text-success">Passed</span>
                            }
                            else
                            {
                                <span class="text-danger">Failed</span>
                            }
                        </td>
                        <td>@result.TakenAt.ToString("f")</td>
                        <td>
                            <a href="@Url.Action("UserExamDetails", new { userExamId = result.UserExam.Id })" 
                               class="btn btn-sm btn-info">
                                <i class="fas fa-eye"></i> Details
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Styles {
    <style>
        .table th {
            background-color: #f8f9fa;
        }
        .badge {
            font-size: 0.9em;
            padding: 0.35em 0.65em;
        }
    </style>
} 