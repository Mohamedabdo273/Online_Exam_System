@{
    Layout = "_Layout";
    ViewData["Title"] = "Exam Result";
}


<div class="container result-container">
    <div class="card result-card">
        <div class="card-header @(ViewBag.Passed ? "bg-success" : "bg-danger") text-white">
            <h2 class="mb-0">Exam Result</h2>
        </div>
        <div class="card-body">
            <h3 class="card-title">@ViewBag.ExamTitle</h3>

            <div class="result-details mt-4">
                <div class="row">
                    <div class="col-md-6">
                        <p><strong>Total Questions:</strong> @ViewBag.TotalQuestions</p>
                        <p><strong>Correct Answers:</strong> @ViewBag.CorrectAnswers</p>
                    </div>
                    <div class="col-md-6">
                        <p><strong>Your Score:</strong> <span class="badge @(ViewBag.Passed ? "bg-success" : "bg-danger")">@ViewBag.Score.ToString("0.00")%</span></p>
                        <p>
                            <strong>Result:</strong>
                            @if (ViewBag.Passed)
                            {
                                <span class="text-success">Passed <i class="fas fa-check-circle"></i></span>
                            }
                            else
                            {
                                <span class="text-danger">Failed <i class="fas fa-times-circle"></i></span>
                            }
                        </p>
                    </div>
                </div>
            </div>

            <div class="progress mt-4 mb-4" style="height: 30px;">
                <div class="progress-bar @(ViewBag.Passed ? "bg-success" : "bg-danger")"
                     role="progressbar"
                     style="width: @ViewBag.Score%"
                     aria-valuenow="@ViewBag.Score"
                     aria-valuemin="0"
                     aria-valuemax="100">
                    @ViewBag.Score.ToString("0.00")%
                </div>
            </div>

            <div class="result-actions mt-4">
                <a href="@Url.Action("Index")" class="btn btn-primary me-2">
                    <i class="fas fa-list"></i> Back to Exams
                </a>
                @if (!ViewBag.Passed)
                {
                    <a href="@Url.Action("TakeExam", new { id = ViewBag.ExamId })" class="btn btn-warning">
                        <i class="fas fa-redo"></i> Retake Exam
                    </a>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('.progress-bar').css('width', '0%').animate({
                width: '@ViewBag.Score%'
            }, 1500);
        });
    </script>
}